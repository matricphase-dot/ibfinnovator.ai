# Supabase → Connect → Session pooler (server only)
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres"
# Supabase → Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_PUBLISHABLE_OR_ANON_KEY"
# Supabase → Settings → API → service_role secret.
# REQUIRED: the Clerk webhook uses this to create shadow auth users and to
# write profiles/identity rows. Without it the webhook throws on every delivery.
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"

# Clerk → dashboard.clerk.com → API keys
# Both must be set together. A malformed publishable key is detected at request
# time and the app falls back to legacy Supabase auth instead of returning 500s.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
# Clerk → Webhooks → your endpoint → Signing secret (starts with whsec_)
CLERK_WEBHOOK_SIGNING_SECRET="whsec_..."

# Set to true only after enabling each provider in Supabase Auth
NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED="false"
NEXT_PUBLIC_GITHUB_OAUTH_ENABLED="false"
# Optional integrations
RESEND_API_KEY=""
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
