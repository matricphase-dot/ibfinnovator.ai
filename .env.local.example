# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase (Pure Supabase Auth — Email, Google, LinkedIn OIDC)
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres"
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_PUBLISHABLE_OR_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"

# Email — Resend
RESEND_API_KEY=""
EMAIL_FROM="IBF <no-reply@innovators-global.com>"

# Error monitoring — Sentry
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# Optional Distributed Rate Limiting — Upstash Redis
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Optional web push
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:support@innovators-global.com"
